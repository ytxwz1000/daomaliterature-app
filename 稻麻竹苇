<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,viewport-fit=cover,user-scalable=no">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="theme-color" content="#f7f6f2">
<title>读 · 文献打卡</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#f7f6f2; --card:#fff; --ink:#1f1e1c; --sub:#8d8a83; --line:#ebe8e1;
  --green:#2f7a56; --green-l:#e8f2ec; --paper:#faf8f3;
  --sb:env(safe-area-inset-bottom,0px); --st:env(safe-area-inset-top,0px);
}
html,body{margin:0;padding:0}
body{
  background:var(--bg); color:var(--ink);
  font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
  font-size:15px; line-height:1.6; padding-bottom:calc(64px + var(--sb));
  overscroll-behavior-y:none;
}
button,input,textarea,select{font-family:inherit;font-size:inherit;color:inherit}
button{border:0;background:none;padding:0;cursor:pointer}
a{color:var(--green);text-decoration:none}

/* ============ 顶栏 ============ */
header{
  position:sticky;top:0;z-index:30;background:rgba(247,246,242,.92);
  backdrop-filter:saturate(180%) blur(12px);-webkit-backdrop-filter:saturate(180%) blur(12px);
  padding-top:var(--st);
}
.hwrap{display:flex;align-items:center;justify-content:space-between;padding:10px 16px 8px}
.hdate{font-size:12px;color:rgba(255,255,255,.85);font-weight:600;letter-spacing:.5px}
.brand{font-size:19px;font-weight:800;letter-spacing:.5px}
.brand span{color:var(--green)}
  display:flex;align-items:center;gap:5px;background:var(--card);border:1px solid var(--line);
  padding:5px 11px;border-radius:20px;font-size:13px;font-weight:700;box-shadow:0 1px 2px rgba(0,0,0,.03)
}
.tabbar{display:flex;justify-content:flex-start}
.tabs{
  display:inline-flex;align-items:center;gap:4px;padding:0 12px 8px;
  max-width:100%;overflow-x:auto;scrollbar-width:none;-webkit-overflow-scrolling:touch
}
.tabs::-webkit-scrollbar{display:none}
.tab{
  flex:0 0 auto;width:max-content;white-space:nowrap;text-align:center;padding:6px 15px;font-size:13.5px;
  color:var(--sub);font-weight:600;border-radius:16px;
  background:var(--card);border:1px solid var(--line);
  transition:color .18s,background .18s,border-color .18s
}
.tab.on{color:#fff;background:var(--green);border-color:var(--green)}
.tab.on:after{display:none}
main{padding:14px 16px 0;animation:fade .25s ease}
@keyframes fade{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.view{display:none}.view.on{display:block}

/* ============ 通用卡片 ============ */
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:14px;margin-bottom:12px}
.row{display:flex;align-items:center;gap:10px}
.grow{flex:1;min-width:0}
.sub{color:var(--sub);font-size:12.5px}
.ell{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.sec-t{font-size:13px;font-weight:800;color:var(--sub);letter-spacing:1px;margin:18px 2px 9px}
.empty{text-align:center;color:var(--sub);padding:44px 20px;font-size:13.5px;line-height:1.9}
.empty div:first-child{font-size:30px;margin-bottom:6px;opacity:.5}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:6px;
  background:var(--green);color:#fff;font-weight:700;padding:11px 18px;border-radius:11px;
  box-shadow:0 2px 8px rgba(47,122,86,.22);transition:transform .12s
}
.btn:active{transform:scale(.97)}
.btn.gh{background:var(--card);color:var(--ink);border:1px solid var(--line);box-shadow:none}
.btn.sm{padding:7px 13px;font-size:13px;border-radius:9px}
.btn.blk{display:flex;width:100%}
.chip{
  display:inline-block;padding:3px 9px;border-radius:20px;font-size:11.5px;font-weight:700;
  background:var(--green-l);color:var(--green);margin:0 5px 5px 0
}
.chip.g{background:#f0eee9;color:var(--sub)}
.chip.y{background:#fdf3e2;color:#b9791c}

/* ============ 今日 ============ */
.hero{
  background:linear-gradient(150deg,#2f7a56,#3f9669 55%,#57ab7c);color:#fff;
  border-radius:18px;padding:16px 18px;margin-bottom:14px;position:relative;overflow:hidden;
  box-shadow:0 6px 18px rgba(47,122,86,.22)
}
.hero:after{content:"";position:absolute;right:-30px;top:-40px;width:130px;height:130px;border-radius:50%;background:rgba(255,255,255,.09)}
.hero:before{content:"";position:absolute;right:40px;bottom:-50px;width:90px;height:90px;border-radius:50%;background:rgba(255,255,255,.07)}
.hero .d{font-size:12px;opacity:.85;letter-spacing:1px;font-weight:600}
.hero .n{font-size:30px;font-weight:800;line-height:1.25;margin-top:2px}
.hero .n i{font-style:normal;font-size:15px;font-weight:600;opacity:.9;margin-left:4px}
.hero .t{font-size:12.5px;opacity:.9;margin-top:2px}
.kpis{display:flex;gap:10px;margin-bottom:14px}
.kpi{flex:1;background:var(--card);border:1px solid var(--line);border-radius:13px;padding:11px 8px;text-align:center}
.kpi b{display:block;font-size:20px;font-weight:800;line-height:1.2}
.kpi span{font-size:11.5px;color:var(--sub)}

.book{display:flex;gap:12px;align-items:flex-start}
.cover{
  width:46px;height:62px;border-radius:5px;flex:none;display:flex;align-items:center;justify-content:center;
  font-size:11px;font-weight:800;color:#fff;text-align:center;line-height:1.25;padding:3px;
  box-shadow:0 2px 6px rgba(0,0,0,.14);letter-spacing:.5px
}
.stitle{font-weight:700;font-size:15px;line-height:1.4}
.pbar{height:5px;background:#efede8;border-radius:4px;overflow:hidden;margin-top:7px}
.pbar i{display:block;height:100%;background:var(--green);border-radius:4px;transition:width .4s}
.meter{display:flex;align-items:center;gap:6px;font-size:12px;color:var(--sub);margin-top:5px}
.meter b{color:var(--green);font-size:13px}
.ring{width:38px;height:38px;flex:none;border-radius:50%;display:grid;place-items:center;font-size:11px;font-weight:800;color:var(--green);background:conic-gradient(var(--green) var(--p,0deg),#eeece7 0deg)}
.ring i{width:28px;height:28px;background:var(--card);border-radius:50%;display:grid;place-items:center;font-style:normal}

/* ============ 书架 ============ */
.filters{display:flex;gap:7px;overflow-x:auto;padding:1px 0 11px;scrollbar-width:none}
.filters::-webkit-scrollbar{display:none}
.fbtn{flex:none;padding:6px 13px;border-radius:20px;background:var(--card);border:1px solid var(--line);font-size:13px;color:var(--sub);font-weight:600}
.fbtn.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:11px}
.bc{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:12px;position:relative;transition:transform .12s}
.bc:active{transform:scale(.98)}
.bc .cover{width:100%;height:96px;font-size:12px;border-radius:7px;margin-bottom:9px}
.bc .st{font-weight:700;font-size:13.5px;line-height:1.35;height:37px;overflow:hidden}
.bc .au{font-size:11.5px;color:var(--sub);margin-top:3px;height:17px;overflow:hidden}
.bc .pg{font-size:11px;color:var(--sub);margin-top:7px;display:flex;justify-content:space-between}
.bc .badge{position:absolute;top:8px;right:8px;font-size:10px;font-weight:800;padding:2px 7px;border-radius:20px;background:rgba(255,255,255,.92);color:var(--ink)}
.bc .badge.stbtn{cursor:pointer;border:1px solid currentColor;box-shadow:0 1px 3px rgba(0,0,0,.12)}
.bc .badge.stbtn:active{transform:scale(.9);background:currentColor}
.bc .badge.stbtn:active span,.bc .badge.stbtn:active{color:#fff}
.fab{
  position:fixed;right:18px;bottom:calc(74px + var(--sb));z-index:40;width:52px;height:52px;border-radius:50%;
  background:var(--ink);color:#fff;font-size:26px;display:grid;place-items:center;
  box-shadow:0 6px 18px rgba(0,0,0,.24);line-height:0;transition:transform .15s
}
.fab:active{transform:scale(.9)}

/* ============ 豆瓣式「书影音标记」书架 ============ */
.sect{margin-bottom:22px}
.sect-h{display:flex;align-items:baseline;gap:7px;padding:0 2px 9px}
.sect-h b{font-size:15.5px;font-weight:800;letter-spacing:.3px}
.sect-h .num{font-size:12px;color:var(--sub);font-weight:700}
.sect-h .more{margin-left:auto;font-size:12.5px;color:var(--sub);font-weight:600;display:flex;align-items:center;gap:2px}
.sect-h .more:active{color:var(--green)}
.rail{display:flex;gap:11px;overflow-x:auto;padding:1px 2px 4px;scrollbar-width:none;-webkit-overflow-scrolling:touch;scroll-snap-type:x proximity}
.rail::-webkit-scrollbar{display:none}
.poster{width:120px;flex:none;scroll-snap-align:start}
.pf{width:120px;height:164px;border-radius:9px;position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;
  color:#fff;text-align:center;line-height:1.3;letter-spacing:.5px;
  box-shadow:0 3px 10px rgba(0,0,0,.16);transition:transform .14s}
.pf:active{transform:scale(.95)}
.pf .ini{font-size:20px;font-weight:800;padding:0 8px;text-shadow:0 1px 3px rgba(0,0,0,.2)}
.pf .spine{position:absolute;left:0;top:0;bottom:0;width:5px;background:rgba(0,0,0,.22)}
.pf .stbadge{position:absolute;right:0;bottom:0;font-size:9.5px;font-weight:800;padding:3px 6px;border-top-left-radius:8px;background:rgba(255,255,255,.94);color:var(--ink)}
.pf .mini{position:absolute;left:0;right:0;bottom:0;height:4px;background:rgba(255,255,255,.32)}
.pf .mini i{display:block;height:100%;background:#fff}
.pf .half{position:absolute;inset:0;background:linear-gradient(100deg,rgba(0,0,0,.28) 0 46%,rgba(0,0,0,0) 46%)}
.poster .t{font-size:12.5px;font-weight:600;line-height:1.35;margin-top:7px;height:34px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.poster .m{font-size:11px;color:var(--sub);margin-top:2px;line-height:1.35;height:30px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical}
.stars{display:inline-flex;gap:1px;font-size:11px;color:#e0a026;line-height:1}
.stars .off{color:#dcd9d2}
.stars.big{font-size:17px;gap:3px}
.poster .rate{display:flex;align-items:center;gap:4px;margin-top:3px;height:16px}
.poster .rate .sc{font-size:11px;color:#e0a026;font-weight:800}
.rail-ph{font-size:12.5px;color:var(--sub);padding:2px 2px 4px}
.sect-h .plus{font-size:12px;color:var(--green);font-weight:700}

/* ============ 记录流 ============ */
.feed{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:13px 14px;margin-bottom:11px}
.fhead{display:flex;align-items:center;gap:8px;margin-bottom:8px}
.av{width:30px;height:30px;border-radius:50%;background:var(--green-l);color:var(--green);display:grid;place-items:center;font-weight:800;font-size:13px;flex:none}
.quote{background:var(--paper);border-left:3px solid var(--green);border-radius:0 8px 8px 0;padding:9px 11px;font-size:13.5px;color:#3d3a35;margin:8px 0}
.note{font-size:13.5px;color:#4a4741;white-space:pre-wrap;word-break:break-word}
.fimg{width:100%;border-radius:10px;margin:9px 0;display:block}
.fact{display:flex;gap:14px;margin-top:9px;padding-top:9px;border-top:1px solid var(--line);font-size:12px;color:var(--sub)}
.fact button{color:var(--sub);font-weight:600;display:flex;align-items:center;gap:4px}
.fact button.on{color:#c2453c}
.timeline{position:relative;padding-left:26px}
.timeline:before{content:"";position:absolute;left:7px;top:6px;bottom:6px;width:2px;background:var(--line)}
.tlitem{position:relative;margin-bottom:14px}
.tlitem:before{content:"";position:absolute;left:-23px;top:6px;width:9px;height:9px;border-radius:50%;background:var(--green);box-shadow:0 0 0 3px var(--bg)}
.tld{font-size:12px;color:var(--sub);font-weight:700;margin-bottom:5px}

/* ============ 统计 ============ */
.hcol{display:flex;flex-direction:column;gap:3px}
.hc.tdy{box-shadow:0 0 0 1.5px #d9562c}
.bars .b{margin-bottom:10px}.bars .bl{align-items:baseline}.bars .bl>span:first-child{flex:0 0 76px;padding-right:8px}.bars .bl .sub{flex:1;text-align:right}.bars .bl .sub{flex:1}
.bars .bl{display:flex;justify-content:space-between;font-size:12.5px;margin-bottom:4px}
.bars .bt{height:8px;background:#efede8;border-radius:5px;overflow:hidden}
.bars .bt i{display:block;height:100%;border-radius:5px;background:var(--green)}

/* ============ 弹层 ============ */
.mask{position:fixed;inset:0;background:rgba(20,19,18,.42);z-index:50;opacity:0;pointer-events:none;transition:opacity .22s}
.mask.on{opacity:1;pointer-events:auto}
.sheet{
  position:fixed;left:0;right:0;bottom:0;z-index:60;background:var(--card);
  border-radius:20px 20px 0 0;max-height:92vh;overflow-y:auto;
  transform:translateY(102%);transition:transform .3s cubic-bezier(.32,.72,0,1);
  padding-bottom:calc(20px + var(--sb));-webkit-overflow-scrolling:touch
}
.sheet.on{transform:translateY(0)}
.grab{width:36px;height:4px;border-radius:4px;background:#dedbd4;margin:9px auto 4px;position:sticky;top:0}
.sh{padding:6px 18px 0}
.sh h3{margin:6px 0 14px;font-size:17px;font-weight:800}
.fl{margin-bottom:14px}
.fl label{display:block;font-size:12px;font-weight:700;color:var(--sub);margin-bottom:6px;letter-spacing:.5px}
.inp,textarea.inp{
  width:100%;background:var(--paper);border:1px solid var(--line);border-radius:11px;padding:11px 12px;outline:none;
  transition:border-color .18s
}
.inp:focus{border-color:var(--green)}
textarea.inp{min-height:76px;resize:vertical;line-height:1.6}
.segs{display:flex;gap:6px;flex-wrap:wrap}
.seg{padding:8px 14px;border-radius:10px;background:var(--paper);border:1px solid var(--line);font-size:13px;font-weight:600;color:var(--sub)}
.seg.on{background:var(--ink);color:#fff;border-color:var(--ink)}
.swatches{display:flex;gap:9px;flex-wrap:wrap}
.sw{width:30px;height:30px;border-radius:50%;position:relative;transition:transform .15s}
.sw.on{transform:scale(1.18)}
.sw.on:after{content:"✓";position:absolute;inset:0;display:grid;place-items:center;color:#fff;font-size:14px;font-weight:900}
.two{display:flex;gap:10px}.two>*{flex:1}
.hint{font-size:11.5px;color:var(--sub);margin-top:-6px;margin-bottom:12px;line-height:1.6}
.danger{color:#c2453c;font-size:13px;font-weight:700;text-align:center;padding:12px}

/* 详情 */
.dhead{display:flex;gap:13px;padding:4px 18px 14px;border-bottom:1px solid var(--line)}
.dhead .cover{width:62px;height:86px;font-size:13px}
.kv{display:flex;gap:10px;padding:9px 0;border-bottom:1px solid var(--line);font-size:13px}
.kv b{width:62px;flex:none;color:var(--sub);font-weight:600;font-size:12.5px}
.stars{display:flex;gap:5px;font-size:24px;color:#e0ddd5;letter-spacing:2px}
.stars span.on{color:#e8a33d}
.acts{display:flex;gap:8px;flex-wrap:wrap;padding:2px 18px 14px}
.acts .btn{flex:1;min-width:110px}

.toast{
  position:fixed;left:50%;bottom:calc(96px + var(--sb));transform:translate(-50%,14px);z-index:99;
  background:rgba(31,30,28,.93);color:#fff;padding:10px 18px;border-radius:22px;font-size:13.5px;font-weight:600;
  opacity:0;pointer-events:none;transition:all .25s;max-width:86vw;text-align:center
}
.toast.on{opacity:1;transform:translate(-50%,0)}
.confetti{position:fixed;top:-14px;width:9px;height:14px;z-index:98;pointer-events:none;border-radius:2px}
textarea{counter-reset:none}
::-webkit-scrollbar{width:0;height:0}
</style>
</head>
<body>

<header>
  <div class="hwrap">
    <div class="brand">读<span>·</span>文献</div>
    <div class="hdate" id="hDateTop"></div>
  </div>
  <div class="tabbar"><div class="tabs">
    <div class="tab on" data-t="today" onclick="go('today')">今日</div>
    <div class="tab" data-t="shelf" onclick="go('shelf')">书架</div>
    <div class="tab" data-t="feed" onclick="go('feed')">动态</div>
    <div class="tab" data-t="stat" onclick="go('stat')">统计</div>
  </div></div>
</header>

<main>
  <!-- 今日 -->
  <section class="view on" id="v-today">
    <div class="hero">
      <div class="d" id="hDate">—</div>
      <div class="n" id="hHeroN">0<i>篇在读</i></div>
      <div class="t" id="hTip">今天还没记，读一段就来写一笔 ✨</div>
    </div>
    <div class="kpis">
      <div class="kpi"><b id="kBook">0</b><span>在读</span></div>
      <div class="kpi"><b id="kDone">0</b><span>已读完</span></div>
      <div class="kpi"><b id="kNote">0</b><span>累计笔记</span></div>
    </div>
    <div class="sec-t">继续阅读</div>
    <div id="readingList"></div>
    <div class="sec-t">最近笔记</div>
    <div id="recentNotes"></div>
  </section>

  <!-- 书架 -->
  <section class="view" id="v-shelf">
    <div id="shelfMarks"></div>
    <div class="empty" id="shelfEmpty" style="display:none">
      <div>📚</div>书架空空的<br>点右下角 + 添加第一篇文献
    </div>
  </section>

  <!-- 动态 -->
  <section class="view" id="v-feed">
    <div class="sec-t" style="margin-top:2px">阅读时间线</div>
    <div class="timeline" id="timeline"></div>
  </section>

  <!-- 统计 -->
  <section class="view" id="v-stat">
    <div class="kpis">
      <div class="kpi"><b id="sBook">0</b><span>文献总数</span></div>
      <div class="kpi"><b id="sDone">0</b><span>已读</span></div>
      <div class="kpi"><b id="sNote">0</b><span>笔记条数</span></div>
    </div>
    <div class="card">
      <div class="sub" style="font-weight:700;letter-spacing:1px;margin-bottom:11px">读完最多的类型</div>
      <div id="typeRank"></div>
    </div>
    <div class="card">
      <div class="sub" style="font-weight:700;letter-spacing:1px;margin-bottom:11px">读得最多的期刊 / 会议</div>
      <div id="journalRank"></div>
    </div>
    <div class="card">
      <div class="sub" style="font-weight:700;letter-spacing:1px;margin-bottom:11px">我的评分分布</div>
      <div class="bars" id="rateDist"></div>
    </div>
    <div class="card">
      <div class="sub" style="font-weight:700;letter-spacing:1px;margin-bottom:11px">我的标签</div>
      <div id="tagCloud"></div>
    </div>
    <button class="btn gh blk" onclick="exportData()">⬇ 导出全部数据（JSON 备份）</button>
    <div style="height:10px"></div>
    <button class="btn gh blk" onclick="importData()">⬆ 导入备份</button>
    <input type="file" id="fileIn" accept=".json" style="display:none" onchange="doImport(event)">
    <p class="hint" style="margin-top:12px">数据仅保存在这台设备的浏览器本地，不会上传。换手机或清理浏览器数据前，记得先导出备份。</p>
  </section>
</main>

<button class="fab" onclick="openBook()" title="添加文献">+</button>

<!-- 添加/编辑文献 -->
<div class="mask" id="mask" onclick="if(event.target===this)closeSheet()"></div>
<div class="sheet" id="sheet">
  <div class="grab"></div>
  <div class="sh" id="sheetBody"></div>
</div>
<div class="toast" id="toast"></div>
<input type="file" id="imgIn" accept="image/*" style="display:none" onchange="doImg(event)">

<script>
/* ================= 数据层 ================= */
const KEY='litlog.v1';
const DEF={books:[],logs:[],profile:{name:'我'}};
let S=load();

function load(){
  try{const d=JSON.parse(localStorage.getItem(KEY));if(d&&d.books)return Object.assign({},DEF,d)}catch(e){}
  return JSON.parse(JSON.stringify(DEF));
}
function save(){localStorage.setItem(KEY,JSON.stringify(S));}
const uid=()=>Date.now().toString(36)+Math.random().toString(36).slice(2,6);
const COLORS=['#2f7a56','#3d6a9e','#9a5b3f','#7b5aa6','#b8863b','#3f8f8f','#a4475f','#5c7a3a'];

/* ================= 工具 ================= */
const $=id=>document.getElementById(id);
const esc=s=>String(s==null?'':s).replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
function dk(d){const x=new Date(d);return x.getFullYear()+'-'+String(x.getMonth()+1).padStart(2,'0')+'-'+String(x.getDate()).padStart(2,'0');}
const today=()=>dk(new Date());
function niceDate(s){
  const t=today(); if(s===t)return '今天';
  const y=dk(Date.now()-864e5); if(s===y)return '昨天';
  const p=s.split('-'); return p[1]+'月'+p[2]+'日';
}
function clock(){const d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}
function toast(m){const t=$('toast');t.textContent=m;t.classList.add('on');clearTimeout(t._h);t._h=setTimeout(()=>t.classList.remove('on'),1900);}
function init0(s){return s.split(/\s+/).filter(Boolean).slice(0,2).map(w=>w[0]).join('').toUpperCase()||'文';}
function book(id){return S.books.find(b=>b.id===id)||{title:'（已删除）',author:'',color:'#999'};}
function logsOf(id){return S.logs.filter(l=>l.bid===id).sort((a,b)=>b.ts-a.ts);}
function totalPages(){return S.books.reduce((s,b)=>s+(+b.pages||0),0);}

/* ================= 视图切换 ================= */
let cur='today';
function go(t){
  cur=t;
  document.querySelectorAll('.tab').forEach(e=>e.classList.toggle('on',e.dataset.t===t));
  document.querySelectorAll('.view').forEach(e=>e.classList.toggle('on',e.id==='v-'+t));
  window.scrollTo({top:0,behavior:'smooth'});
  render();
}
function render(){
  if(cur==='today')rToday();
  if(cur==='shelf')rShelf();
  if(cur==='feed')rFeed();
  if(cur==='stat')rStat();
}

/* ================= 今日 ================= */
function rToday(){
  const d=new Date(), w=['周日','周一','周二','周三','周四','周五','周六'][d.getDay()];
  $('hDate').textContent=(d.getMonth()+1)+'月'+d.getDate()+'日 · '+w;
  $('hDateTop').textContent=(d.getMonth()+1)+'/'+d.getDate()+' '+w;
  const readingAll=S.books.filter(b=>b.status==='reading');
  $('hHeroN').innerHTML=readingAll.length+'<i>篇在读</i>';
  $('hTip').textContent = readingAll.length
    ? '共 '+S.books.length+' 篇文献 · 已读 '+S.books.filter(b=>b.status==='done').length+' 篇 · 累计 '+totalPages()+' 页'
    : '书架空空的，先添加一篇文献吧 📚';
  $('kBook').textContent=readingAll.length;
  $('kDone').textContent=S.books.filter(b=>b.status==='done').length;
  $('kNote').textContent=S.logs.filter(l=>l.note&&l.note.trim()).length;

  const reading=S.books.filter(b=>b.status==='reading')
    .sort((a,b)=>(b.lastTs||0)-(a.lastTs||0));
  $('readingList').innerHTML = reading.length? reading.map(b=>{
    const ls=logsOf(b.id), done=+b.pages||0, tot=+b.total||0;
    const p=tot?Math.min(100,Math.round(done/tot*100)):0;
    return `<div class="card book" onclick="detail('${b.id}')">
      <div class="cover" style="background:${b.color}">${esc(init0(b.title))}</div>
      <div class="grow">
        <div class="stitle ell">${esc(b.title)}</div>
        <div class="sub ell">${esc(b.author||'佚名')}${b.type?' · '+esc(b.type):''}</div>
        <div class="pbar"><i style="width:${p}%"></i></div>
        <div class="meter"><b>${p}%</b>${tot?'<span>第 '+done+' / '+tot+' 页</span>':'<span>'+ls.length+' 条记录</span>'}
          <span style="margin-left:auto">${ls.length?'最近 '+niceDate(ls[0].day):'还没开始'}</span></div>
      </div>
      <button class="btn sm" onclick="event.stopPropagation();openLog('${b.id}')" style="align-self:center">记一笔</button>
    </div>`;
  }).join('') : `<div class="card empty" style="padding:26px"><div>☕</div>还没有在读的文献<br><button class="btn sm" style="margin-top:12px" onclick="openBook()">去添加</button></div>`;

  const rn=S.logs.filter(l=>l.note&&l.note.trim()).sort((a,b)=>b.ts-a.ts).slice(0,3);
  $('recentNotes').innerHTML = rn.length? rn.map(logItem).join('')
    : `<div class="card empty" style="padding:24px"><div>✍️</div>读完记一句想法，日后就是一笔财富</div>`;
}

/* ================= 书架：豆瓣式「书影音标记」 ================= */
let filter='all';
const FIL=[['all','全部'],['reading','在读'],['want','想读'],['done','已读']];
const SEC=[
  {st:'reading',icon:'📖',name:'在读',desc:'正在读，会出现在今日页'},
  {st:'want',icon:'🔖',name:'想读',desc:'先记下来，以后再读'},
  {st:'done',icon:'✅',name:'读过',desc:'已完成，计入已读数量'}
];
const RATE=[1,2,3,4,5];
function stars(n,cls){
  n=+n||0;
  let h='<span class="stars '+(cls||'')+'">';
  for(let i=1;i<=5;i++)h+= i<=n?'★':'<span class="off">★</span>';
  return h+'</span>';
}
function rateOf(b){return Math.max(0,Math.min(5,+b.rate||0));}
function poster(b,compact){
  const tot=+b.total||0,done=+b.pages||0,p=tot?Math.min(100,Math.round(done/tot*100)):0;
  const bd=ST_META[b.status];
  const sd={reading:'#eef6f1',want:'#fdf3e2',done:'#f0eee9'}[b.status];
  const metaLine = b.status==='done'
      ? (rateOf(b)?stars(rateOf(b))+'<span class="sc">'+rateOf(b)+'.0</span>':'<span class="sub">没评分</span>')
      : (b.status==='reading'&&tot ? '<span class="sub">'+p+'% · '+done+'/'+tot+'页</span>'
        : '<span class="sub">'+esc(b.year||b.type||'—')+'</span>');
  const mini = (b.status==='reading'&&tot) ? '<div class="mini"><i style="width:'+p+'%"></i></div>' : '';
  return `<div class="poster" data-bid="${b.id}" onclick="detail('${b.id}')">
    <div class="pf" style="background:${b.color}">
      <span class="spine"></span>
      ${compact?'':'<span class="half"></span>'}
      <span class="ini">${esc(init0(b.title))}</span>
      ${mini}
      <span class="stbadge" style="background:${sd}" onclick="event.stopPropagation();statusSheet('${b.id}')">${bd[0]} ⇄</span>
    </div>
    <div class="t">${esc(b.title)}</div>
    <div class="m">${esc(b.author||'佚名')}${b.year?' · '+esc(b.year):(b.type?' · '+esc(b.type):'')}</div>
    <div class="rate">${metaLine}</div>
  </div>`;
}
function rShelf(){
  const all=S.books;
  $('shelfEmpty').style.display=all.length?'none':'block';
  const cnt=st=>all.filter(b=>b.status===st).length;
  let h=`<div class="filters">${FIL.map(f=>{
    const n=f[0]==='all'?all.length:cnt(f[0]);
    return `<button class="fbtn ${filter===f[0]?'on':''}" onclick="filter='${f[0]}';rShelf()">${f[1]} ${n}</button>`;
  }).join('')}</div>`;

  if(filter==='all'){
    // 豆瓣式：每个状态一个区块 + 横向滑动封面墙
    SEC.forEach(s=>{
      const list=all.filter(b=>b.status===s.st).sort((a,b)=>(b.lastTs||0)-(a.lastTs||0));
      h+=`<div class="sect">
        <div class="sect-h"><span>${s.icon}</span><b>${s.name}</b><span class="num">${list.length}</span>
          ${list.length>3?`<span class="more" onclick="filter='${s.st}';rShelf()">全部 ›</span>`:''}
          <span class="more" onclick="openBook()"><span class="plus">＋ 添加</span></span>
        </div>
        ${list.length
          ? `<div class="rail">${list.map(b=>poster(b)).join('')}</div>`
          : `<div class="rail-ph">还没有标记为「${s.name}」的文献　<span class="plus" onclick="openBook()">＋ 添加一篇</span></div>`}
      </div>`;
    });
    if(all.length){
      const rated=all.filter(b=>rateOf(b)>0);
      const avg=rated.length?(rated.reduce((s,b)=>s+rateOf(b),0)/rated.length).toFixed(1):'—';
      h+=`<div class="card row" style="gap:14px;margin-bottom:calc(4px + 56px + var(--sb))">
        <div style="text-align:center;padding:0 4px"><div style="font-size:22px;font-weight:800;color:#e0a026;line-height:1">${avg}</div><div class="sub" style="font-size:10.5px">平均评分</div></div>
        <div class="grow"><div class="sub">共 ${all.length} 篇文献 · 已读完 ${cnt('done')} 篇${rated.length?' · '+rated.length+' 篇已评分':''}</div>
        <div style="margin-top:6px">${(all.length>=5?['近期最投入','页数最多','评分最高']:[]).map(t=>`<span class="chip g">${t}</span>`).join('')}</div></div>
      </div>`;
    }
  }else{
    const s=SEC.find(x=>x.st===filter);
    const list=all.filter(b=>b.status===filter).sort((a,b)=>(b.lastTs||0)-(a.lastTs||0));
    h+=`<div class="sect">
      <div class="sect-h"><span>${s.icon}</span><b>${s.name}</b><span class="num">${list.length}</span>
        <span class="more" onclick="filter='all';rShelf()">‹ 返回书架</span></div>
      <div class="sub" style="padding:0 2px 10px;margin-top:-4px">${s.desc}　点封面看详情，点右下角标签直接改状态</div>
      <div class="rail" style="flex-wrap:wrap;gap:14px 11px">${list.map(b=>poster(b)).join('')}</div>
    </div>`;
  }
  $('shelfMarks').innerHTML=h;
}
function setRate(id,n,e){
  if(e&&e.stopPropagation)e.stopPropagation();
  const b=book(id);
  const prev=rateOf(b);                 // 先取旧值，避免赋值后自比较导致误判为「取消」
  b.rate=(prev===n)?0:n;                // 点当前已评的那颗星 = 取消评分
  let moved=false;
  if(b.rate&&b.status!=='done'){setStatus(id,'done',true);moved=true;}
  save();
  // 只刷新这一张海报，避免整页重渲染把弹层冲掉
  const node=document.querySelector('.poster[data-bid="'+id+'"]');
  if(node&&cur==='shelf'){node.outerHTML=poster(b);}
  else render();
  if(moved)toast('已评 '+b.rate+' 星，归入「读过」⭐');
  else toast(b.rate?('已评 '+b.rate+' 星 ⭐'):'已取消评分');
}
function rateSheet(id){
  const b=book(id);
  openSheet(`
    <h3>给《${esc(b.title.slice(0,14))}${b.title.length>14?'…':''}》打分</h3>
    <div style="text-align:center;padding:10px 0 16px">
      <div style="font-size:34px;letter-spacing:6px;color:#e0a026;line-height:1">${RATE.map(n=>`<span onclick="setRate('${id}',${n},event)" style="cursor:pointer;${n<=rateOf(b)?'':'color:#dcd9d2'}">★</span>`).join('')}</div>
      <div class="sub" style="margin-top:8px">${rateOf(b)?rateOf(b)+' 星 · '+['很差','较差','还行','不错','经典'][rateOf(b)-1]:'还没评分'}</div>
    </div>
    <div class="hint">评分只在本地保存，不会上传到任何地方。给文献打分后会自动归入「读过」。</div>
    <button class="btn blk gh" style="margin-top:12px" onclick="closeSheet()">关闭</button>
  `);
}

/* ================= 动态 ================= */
function logItem(l){
  const b=book(l.bid);
  return `<div class="feed">
    <div class="fhead">
      <div class="av">${esc(S.profile.name.slice(0,1))}</div>
      <div class="grow">
        <div style="font-weight:700;font-size:13.5px">${esc(S.profile.name)}
          <span class="sub" style="font-weight:500"> ${l.day?'· '+niceDate(l.day)+(l.time?' '+l.time:''):''}</span></div>
        <div class="sub ell">《${esc(b.title)}》${l.pages?' · 读到第 '+l.pages+' 页':''}${ST_META[b.status]?' · '+ST_META[b.status][0]:''}</div>
      </div>
      <button class="sub" style="font-size:16px" onclick="delLog('${l.id}')">🗑</button>
    </div>
    ${l.img?`<img class="fimg" src="${l.img}" onclick="viewImg(this.src)">`:''}
    ${l.quote?`<div class="quote">「${esc(l.quote)}」</div>`:''}
    ${l.note?`<div class="note">${esc(l.note)}</div>`:''}
    ${(l.tags&&l.tags.length)?`<div style="margin-top:8px">${l.tags.map(t=>`<span class="chip">#${esc(t)}</span>`).join('')}</div>`:''}
  </div>`;
}
function rFeed(){
  const ls=[...S.logs].sort((a,b)=>b.ts-a.ts);
  if(!ls.length){$('timeline').innerHTML=`<div class="empty"><div>🕰</div>还没有记录<br>去书架点「记一笔」写下第一条</div>`;return;}
  let html='',lastD='';
  ls.forEach(l=>{
    if(l.day!==lastD){
      lastD=l.day;
      const n=S.logs.filter(x=>x.day===l.day).length;
      html+=`<div class="tlitem"><div class="tld">${niceDate(l.day)} · ${n} 条记录</div>${logItem(l)}</div>`;
    }else html+=`<div class="tlitem" style="margin-left:0">${logItem(l)}</div>`;
  });
  $('timeline').innerHTML=html;
}
function delLog(id){
  if(!confirm('删除这条打卡记录？'))return;
  S.logs=S.logs.filter(l=>l.id!==id);save();render();toast('已删除');
}
function viewImg(src){
  const m=document.createElement('div');
  m.style='position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:999;display:grid;place-items:center;padding:20px';
  m.innerHTML=`<img src="${src}" style="max-width:100%;max-height:86vh;border-radius:8px">`;
  m.onclick=()=>m.remove();document.body.appendChild(m);
}

/* ================= 统计 ================= */
function rankBar(el,rows,unit){
  const mx=Math.max(1,...rows.map(r=>r[1]));
  if(!rows.length){$(el).innerHTML='<div class="sub">还没有数据</div>';return;}
  $(el).innerHTML=rows.map(r=>`<div style="margin-bottom:10px"><div style="display:flex;justify-content:space-between;gap:10px;font-size:13px;margin-bottom:4px"><span style="flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap">${esc(r[0])}</span><span class="sub" style="flex:none">${r[1]} ${unit}</span></div><div class="bt"><i style="width:${r[1]/mx*100}%"></i></div></div>`).join('');
}
function rStat(){
  const B=S.books, L=S.logs;
  $('sBook').textContent=B.length;
  $('sDone').textContent=B.filter(b=>b.status==='done').length;
  $('sNote').textContent=L.filter(l=>(l.note&&l.note.trim())||(l.quote&&l.quote.trim())).length;

  const cnt=k=>{const o={};B.forEach(b=>{const v=String(b[k]||'').trim();if(v)o[v]=(o[v]||0)+1});
    return Object.entries(o).sort((a,b)=>b[1]-a[1]).slice(0,6);};
  rankBar('typeRank',cnt('type'),'篇');
  rankBar('journalRank',cnt('journal'),'篇');

  const rc=[1,2,3,4,5].map(r=>[r+' 星',B.filter(b=>(+b.rate||0)===r).length]);
  rankBar('rateDist',rc,'篇');

  const tg={};L.forEach(l=>(l.tags||[]).forEach(t=>tg[t]=(tg[t]||0)+1));
  const tk=Object.entries(tg).sort((a,b)=>b[1]-a[1]);
  $('tagCloud').innerHTML=tk.length?tk.map(([t,n])=>`<span class="chip" style="font-size:${Math.min(17,11+n*1.4)}px;padding:${4+Math.min(6,n)}px ${10+Math.min(8,n*2)}px">#${esc(t)} <b style="opacity:.6">${n}</b></span>`).join(''):'<div class="sub">记笔记时加上标签，这里会自动汇总</div>';
}

/* ================= 弹层 ================= */
let sheetEl=$('sheet');
function openSheet(html){
  $('sheetBody').innerHTML=html;sheetEl.classList.add('on');$('mask').classList.add('on');
}
function closeSheet(){sheetEl.classList.remove('on');$('mask').classList.remove('on');}

/* --- 添加/编辑文献 --- */
let editId=null,pickColor=COLORS[0];
const TYPES=['期刊论文','会议论文','学位论文','专著/图书','专利','报告','标准','预印本'];
function openBook(id){
  editId=id||null;
  const b=id?book(id):{title:'',author:'',type:'期刊论文',year:'',journal:'',doi:'',total:'',pages:'',status:'reading',tags:'',color:COLORS[S.books.length%COLORS.length],note:''};
  pickColor=b.color;
  openSheet(`
    <h3>${id?'编辑文献':'添加文献'}</h3>
    <div class="fl"><label>标题 *</label><input class="inp" id="fT" value="${esc(b.title)}" placeholder="如：Attention Is All You Need"></div>
    <div class="two">
      <div class="fl"><label>作者</label><input class="inp" id="fA" value="${esc(b.author)}" placeholder="Vaswani 等"></div>
      <div class="fl"><label>年份</label><input class="inp" id="fY" value="${esc(b.year)}" placeholder="2017" inputmode="numeric"></div>
    </div>
    <div class="fl"><label>类型</label><div class="segs" id="fType">${TYPES.map(t=>`<button class="seg ${b.type===t?'on':''}" onclick="pick('fType',this)">${t}</button>`).join('')}</div></div>
    <div class="fl"><label>期刊 / 会议 / 学校</label><input class="inp" id="fJ" value="${esc(b.journal)}" placeholder="NeurIPS 2017"></div>
    <div class="fl"><label>DOI / 链接</label><input class="inp" id="fD" value="${esc(b.doi)}" placeholder="10.xxxx/xxxxx 或 https://"></div>
    <div class="two">
      <div class="fl"><label>总页数</label><input class="inp" id="fTot" value="${esc(b.total)}" inputmode="numeric" placeholder="15"></div>
      <div class="fl"><label>已读到第几页</label><input class="inp" id="fPg" value="${esc(b.pages)}" inputmode="numeric" placeholder="0"></div>
    </div>
    <div class="fl"><label>状态</label><div class="segs" id="fSt">
      ${[['reading','在读'],['want','想读'],['done','已读']].map(s=>`<button class="seg ${b.status===s[0]?'on':''}" onclick="pick('fSt',this)">${s[1]}</button>`).join('')}
    </div></div>
    <div class="fl"><label>标签（空格分隔）</label><input class="inp" id="fTag" value="${esc(b.tags)}" placeholder="Transformer 综述 精读"></div>
    <div class="fl"><label>研究问题 / 我的备注</label><textarea class="inp" id="fN" placeholder="这篇想解决什么问题？跟我课题的关系？">${esc(b.note)}</textarea></div>
    <div class="fl"><label>书脊颜色</label><div class="swatches" id="fC">${COLORS.map(c=>`<div class="sw ${c===pickColor?'on':''}" style="background:${c}" onclick="pickColor='${c}';document.querySelectorAll('#fC .sw').forEach(e=>e.classList.remove('on'));this.classList.add('on')"></div>`).join('')}</div></div>
    <button class="btn blk" onclick="saveBook()">${id?'保存修改':'加入书架'}</button>
    ${id?`<div class="danger" onclick="delBook('${id}')">删除这篇文献及其全部阅读记录</div>`:''}
  `);
}
function pick(id,el){document.querySelectorAll('#'+id+' .seg').forEach(e=>e.classList.remove('on'));el.classList.add('on');}
function val(id){return $(id).value.trim();}
function segOf(id){const e=document.querySelector('#'+id+' .seg.on');return e?e.textContent.trim():'';}
function saveBook(){
  const t=val('fT'); if(!t){toast('先写个标题吧');return;}
  const st={reading:'reading',want:'want',done:'done'}[segOf('fSt')]||'reading';
  if(editId){
    const b=book(editId);
    Object.assign(b,{title:t,author:val('fA'),year:val('fY'),type:segOf('fType'),journal:val('fJ'),doi:val('fD'),
      total:+val('fTot')||0,pages:+val('fPg')||0,status:st,tags:val('fTag'),note:val('fN'),color:pickColor});
    if(st==='done'&&b.total)b.pages=b.total;
    toast('已保存');
  }else{
    S.books.push({id:uid(),title:t,author:val('fA'),year:val('fY'),type:segOf('fType'),journal:val('fJ'),doi:val('fD'),
      total:+val('fTot')||0,pages:+val('fPg')||0,status:st,tags:val('fTag'),note:val('fN'),color:pickColor,
      lastTs:Date.now(),created:today()});
    toast('已加入书架 📚');
  }
  save();closeSheet();render();
}
function delBook(id){
  if(!confirm('确定删除？相关阅读记录也会一并删除。'))return;
  S.books=S.books.filter(b=>b.id!==id);S.logs=S.logs.filter(l=>l.bid!==id);
  save();closeSheet();render();toast('已删除');
}

/* --- 详情 --- */
function detail(id){
  const b=book(id), ls=logsOf(id);
  const tot=+b.total||0,done=+b.pages||0,p=tot?Math.min(100,Math.round(done/tot*100)):0;
  openSheet(`
    <div class="dhead">
      <div class="cover" style="background:${b.color}">${esc(init0(b.title))}</div>
      <div class="grow">
        <div style="font-weight:800;font-size:16px;line-height:1.4">${esc(b.title)}</div>
        <div class="sub" style="margin-top:3px">${esc(b.author||'佚名')}${b.year?' · '+b.year:''}</div>
        <div class="sub">${esc(b.type||'')}${b.journal?' · '+esc(b.journal):''}</div>
        <div style="margin-top:6px">${tot?`<span class="chip">${p}% · ${done}/${tot}页</span>`:''}<span class="chip g">${ls.length} 条记录</span>${rateOf(b)?`<span class="chip g">${rateOf(b)}.0 分</span>`:''}</div>
      </div>
    </div>
    <div style="padding:12px 18px 0">
      <div class="kv"><b>评分</b><div class="grow" onclick="rateSheet('${id}')" style="cursor:pointer">
        ${rateOf(b)?stars(rateOf(b),'big')+'<span class="sub" style="margin-left:6px">'+rateOf(b)+'.0 分 · 点击修改</span>':'<span class="sub">☆ 点这里给这篇打分</span>'}
      </div></div>
      ${b.doi?`<div class="kv"><b>DOI/链接</b><span class="grow ell">${esc(b.doi)}</span>${/^https?:/.test(b.doi)?`<a href="${esc(b.doi)}" target="_blank" style="font-weight:700">打开</a>`:`<button class="sub" style="font-weight:700" onclick="copy('${esc(b.doi).replace(/'/g,"")}')">复制</button>`}</span></div>`:''}
      ${b.tags?`<div class="kv"><b>标签</b><div class="grow">${String(b.tags).split(/[\s,，]+/).filter(Boolean).map(t=>`<span class="chip">#${esc(t)}</span>`).join('')}</div></div>`:''}
      ${b.note?`<div class="kv"><b>备注</b><div class="grow" style="white-space:pre-wrap;color:#4a4741">${esc(b.note)}</div></div>`:''}
      <div class="kv"><b>进度</b><div class="grow"><input type="range" min="0" max="${tot||100}" value="${done}" oninput="quickPage('${id}',this.value)" style="width:100%;accent-color:#2f7a56"><div class="sub">拖动可直接更新页码${tot?'（共 '+tot+' 页）':''}</div></div></div>
    </div>
    <div class="acts" style="padding-top:14px">
      <button class="btn" onclick="openLog('${id}')">✍️ 记一笔</button>
      <button class="btn gh" onclick="statusSheet('${id}')">🔄 ${ST_META[b.status][0]}</button>
      <button class="btn gh" onclick="openBook('${id}')">编辑</button>
      ${b.status!=='done'?`<button class="btn gh" onclick="finish('${id}')">✅ 标记读完</button>`:''}
    </div>
    <div class="sec-t" style="padding:0 18px">阅读记录</div>
    <div style="padding:0 18px">${ls.length?ls.map(logItem).join(''):'<div class="sub" style="padding:6px 0 10px">还没有记录，读完一段就来写一笔</div>'}</div>
  `);
}
function quickPage(id,v){
  const b=book(id);b.pages=+v;
  if(b.total&&+v>=b.total)b.status='done';
  save();
  const el=document.querySelector('#sheetBody .chip');
  if(el)el.textContent=(b.total?Math.round(v/b.total*100):0)+'% · '+v+'/'+b.total+'页';
}
function finish(id){
  const b=book(id);b.status='done';if(b.total)b.pages=b.total;
  save();detail(id);render();celebrate('读完《'+b.title+'》🎉');
}
/* --- 状态快捷切换 --- */
const ST_META={want:['想读','#b9791c'],reading:['在读','var(--green)'],done:['已读','#8d8a83']};
const ST_ORDER=['want','reading','done'];
function setStatus(id,st,silent){
  const b=book(id);if(!b)return;
  const old=b.status;
  b.status=st;
  if(st==='done'&&b.total&&!b.pages)b.pages=b.total;   // 标记已读且没填页码 → 视为读完
  if(st==='reading'&&old==='done'&&b.total&&b.pages>=b.total)b.pages=0; // 已读退回在读 → 进度清零重读
  b.lastTs=Date.now();
  save();render();
  if(!silent)toast('《'+b.title.slice(0,12)+'》→ '+ST_META[st][0]);
}
function cycleStatus(id){
  const b=book(id);if(!b)return;
  const nx=ST_ORDER[(ST_ORDER.indexOf(b.status)+1)%ST_ORDER.length];
  setStatus(id,nx);
}
function statusSheet(id){
  const b=book(id);if(!b)return;
  openSheet(`
    <h3>《${esc(b.title.slice(0,16))}${b.title.length>16?'…':''}》</h3>
    <div class="sub" style="margin:-6px 0 14px">当前状态：<b style="color:${ST_META[b.status][1]}">${ST_META[b.status][0]}</b>　点下面任一项直接改</div>
    ${ST_ORDER.map(s=>`
      <div onclick="setStatus('${id}','${s}');closeSheet()" style="display:flex;align-items:center;gap:10px;padding:14px;border-radius:12px;margin-bottom:8px;cursor:pointer;background:${b.status===s?'#eef6f1':'#f6f5f2'};border:1.5px solid ${b.status===s?'var(--green)':'transparent'}">
        <span style="font-size:20px">${{want:'🔖',reading:'📖',done:'✅'}[s]}</span>
        <span style="font-weight:800;color:${ST_META[s][1]}">${ST_META[s][0]}</span>
        <span class="grow sub">${{want:'先记下来，以后再读',reading:'正在读，会出现在今日页',done:'读完了，计入已读统计'}[s]}</span>
        ${b.status===s?'<span style="color:var(--green);font-weight:800">✓</span>':''}
      </div>`).join('')}
    <div class="hint" style="margin-top:6px">书架卡片右上角的状态标签，点一下也能按顺序快速切换。</div>
  `);
}
function copy(t){navigator.clipboard&&navigator.clipboard.writeText(t);toast('已复制');}

/* --- 打卡 --- */
let logDraft={};
function openLog(id){
  const b=book(id);
  const last=logsOf(id)[0];
  logDraft={bid:id,pages:last?last.pages:(b.pages||''),img:''};
  openSheet(`
    <h3>记一笔 · <span style="color:#2f7a56">${esc(b.title.slice(0,14))}${b.title.length>14?'…':''}</span></h3>
    <div class="fl"><label>读到第几页</label><input class="inp" id="lPg" value="${esc(logDraft.pages)}" inputmode="numeric" oninput="logDraft.pages=this.value" placeholder="留空则不更新"></div>
    <div class="fl"><label>拍张笔记照 / 文献截图</label>
      <button class="btn gh blk" onclick="$('imgIn').click()">📷 ${logDraft.img?'重新选择':'选择图片'}</button>
      <img id="lPrev" style="display:none;width:100%;border-radius:10px;margin-top:9px">
    </div>
    <div class="fl"><label>金句摘录</label><textarea class="inp" id="lQ" placeholder="书里最打动你的一句话" style="min-height:56px"></textarea></div>
    <div class="fl"><label>读书笔记</label><textarea class="inp" id="lN" placeholder="方法思路、和自己研究的关系、疑问…"></textarea></div>
    <div class="fl"><label>标签</label><input class="inp" id="lT" placeholder="空格分隔，如：方法论 可复现">
      <div style="margin-top:7px">${['方法论','实验设计','综述','可复现','争议点','灵感','精读','泛读'].map(t=>`<span class="chip g" onclick="addTag('${t}')">+ ${t}</span>`).join('')}</div>
    </div>
    <button class="btn blk" onclick="saveLog()">保存记录 ✍️</button>
    <div class="hint" style="margin-top:10px">这篇目前 ${b.total?Math.round(((+b.pages||0)/b.total*100)):0}% · ${b.pages||0}${b.total?' / '+b.total:''} 页${b.status?' · 当前'+ST_META[b.status][0]:''}</div>
  `);
}
function addTag(t){const i=$('lT');const a=i.value.split(/\s+/).filter(Boolean);a.includes(t)?a.splice(a.indexOf(t),1):a.push(t);i.value=a.join(' ');}
function doImg(e){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{compress(r.result,640,d=>{logDraft.img=d;const p=$('lPrev');p.src=d;p.style.display='block';});};
  r.readAsDataURL(f);e.target.value='';
}
function compress(src,max,cb){
  const im=new Image();
  im.onload=()=>{const s=Math.min(1,max/Math.max(im.width,im.height));
    const c=document.createElement('canvas');c.width=im.width*s;c.height=im.height*s;
    c.getContext('2d').drawImage(im,0,0,c.width,c.height);cb(c.toDataURL('image/jpeg',.78));};
  im.src=src;
}
function saveLog(){
  const bid=logDraft.bid, b=book(bid);
  const pg=val('lPg');
  const q=val('lQ'), n=val('lN');
  if(!pg&&!q&&!n&&!logDraft.img){toast('写点什么再保存吧，哪怕一句也好');return;}
  const l={id:uid(),bid,day:today(),time:clock(),
    pages:pg?+pg:'',quote:q,note:n,
    tags:$('lT').value.split(/\s+/).filter(Boolean),img:logDraft.img||'',ts:Date.now()};
  S.logs.push(l);
  if(pg&&+pg>=(b.total||0)&&b.total){b.status='done';b.pages=b.total;celebrate('读完《'+b.title+'》🎉');}
  else if(pg&&+pg>(b.pages||0))b.pages=+pg;
  b.lastTs=Date.now();
  save();closeSheet();render();
  if(l.pages&&b.total&&+l.pages>=b.total)return;
  toast('记下了 ✍️ 累计 '+S.logs.length+' 条笔记');
}
function celebrate(msg){
  const box=document.createElement('div');
  box.style='position:fixed;inset:0;pointer-events:none;z-index:98;overflow:hidden';
  const cs=['#2f7a56','#e8a33d','#d9562c','#3d6a9e','#7b5aa6'];
  for(let i=0;i<26;i++){
    const c=document.createElement('i');
    c.style.cssText='position:absolute;left:'+Math.random()*100+'%;top:-20px;width:8px;height:13px;border-radius:2px;background:'+cs[i%cs.length];
    box.appendChild(c);
  }
  document.body.appendChild(box);
  if(typeof box.firstChild==='object'&&box.firstChild.animate){
    Array.from(box.children).forEach(c=>c.animate([{transform:'translateY(0) rotate(0)',opacity:1},
      {transform:'translateY('+(innerHeight+40)+'px) rotate('+(Math.random()*720-360)+'deg)',opacity:.2}],
      {duration:1400+Math.random()*900,delay:Math.random()*260,easing:'cubic-bezier(.2,.6,.4,1)'}));
  }
  setTimeout(()=>box.remove(),2600);
  toast(msg);
}

/* ================= 导入导出 ================= */
function exportData(){
  const blob=new Blob([JSON.stringify(S,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);a.download='文献打卡备份_'+today()+'.json';a.click();
  toast('备份已导出');
}
function importData(){$('fileIn').click();}
function doImport(e){
  const f=e.target.files[0];if(!f)return;
  const r=new FileReader();
  r.onload=()=>{try{const d=JSON.parse(r.result);if(!d.books)throw 0;
    if(confirm('导入将覆盖当前数据，继续？')){S=Object.assign({},DEF,d);save();render();toast('导入成功');}
  }catch(err){toast('文件格式不对');}};
  r.readAsText(f);e.target.value='';
}

